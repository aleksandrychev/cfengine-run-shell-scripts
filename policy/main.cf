body file control
{
  namespace => "run_shell_scripts";
}

bundle agent main
# @brief Runs each script listed in "scripts", gated by its own "condition"
#   and spaced out by its own "ifelapsed".
{
  vars:
    "idx" slist => getindices("scripts");

    "condition[$(idx)]"
      string => "$(scripts[$(idx)][condition])",
      if => isvariable("scripts[$(idx)][condition]");

    "condition[$(idx)]"
      string => "any",
      unless => isvariable("scripts[$(idx)][condition]");

    "ifelapsed[$(idx)]"
      string => "$(scripts[$(idx)][ifelapsed])",
      if => isvariable("scripts[$(idx)][ifelapsed]");

    "ifelapsed[$(idx)]"
      string => "0",
      unless => isvariable("scripts[$(idx)][ifelapsed]");

  classes:
    "have_scripts" expression => isvariable("scripts");

  commands:
    have_scripts::
      "/bin/bash"
        args => "$(scripts[$(idx)][path])",
        contain => run_as_root,
        action => scheduled("$(ifelapsed[$(idx)])"),
        if => "$(condition[$(idx)])",
        handle => canonify("run_shell_scripts_run_$(scripts[$(idx)][path])");

  reports:
    "run-shell-scripts: no scripts configured, run 'cfbs input run-shell-scripts'"
      if => not("have_scripts");
}

body contain run_as_root
{
  useshell => "false";
  exec_owner => "root";
  exec_timeout => "600";
}

body action scheduled(x)
# @param x Minutes between runs (see body common ifelapsed); "0" runs every time.
{
  ifelapsed => "$(x)";
}

body file control
{
  namespace => "default";
}
